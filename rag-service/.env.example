# ── RAG Service (.env) ────────────────────────────────────────────────────────

# OpenAI / Azure OpenAI
USE_AZURE=True
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2023-07-01-preview
OPENAI_EMBEDDING_MODEL=azure-openai-embedding-deployment
# OPENAI_EMBEDDING_DIMENSIONS=1536
# OPENAI_EMBEDDING_BATCH_SIZE=512
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_RERANK_MODEL=gpt-4o-mini

# Database (matches docker-compose default)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/ragdb
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chat_rag

# Security -- change this before deploying anywhere
API_KEY=dev-secret-change-in-prod

# App
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# Retrieval tuning (optional -- defaults are good to start)
# RETRIEVAL_TOP_K=20
# RETRIEVAL_RERANK_TOP_N=5
# RETRIEVAL_MIN_SCORE=0.3

# Chunking tuning (optional)
# CHUNK_SIZE_TOKENS=512
# CHUNK_OVERLAP_TOKENS=51
