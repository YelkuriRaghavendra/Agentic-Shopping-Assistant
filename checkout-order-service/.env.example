# ── Checkout/Order Service (.env) ─────────────────────────────────────────────

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/chat

# Feature flags
FEATURE_FLAG_FORCE_ENABLE=true

# Merchant UCP discovery -- point to checkout service itself for local dev
MERCHANT_DEFAULT_MERCHANT_BASE_URL=http://localhost:3001
PLATFORM_BASE_URL=http://localhost:3001

# Local dev: skip outbound UCP calls to avoid self-referencing loop
SKIP_UCP_OUTBOUND=true
