# ── Backend (.env) ────────────────────────────────────────────────────────────

# LLM Provider
USE_AZURE=true
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_FALLBACK=gpt-4o-mini

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chat

# RAG service connection
RAG_SERVICE_URL=http://localhost:8001
RAG_API_KEY=dev-secret-change-in-prod

# Security -- must match RAG service API_KEY
API_KEY=dev-secret-change-in-prod

# Commerce Service (checkout-order-service)
COMMERCE_SERVICE_URL=http://localhost:3001
FEATURE_FLAG_FORCE_ENABLE=true
LAUNCHDARKLY_SDK_KEY=your-launchdarkly-sdk-key-here

# LangGraph
USE_PG_CHECKPOINTER=false

# LangSmith Observability (optional — set API key to enable tracing)
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=vikrai
LANGCHAIN_TRACING_V2=true

# App
DEBUG=false
LOG_LEVEL=INFO
